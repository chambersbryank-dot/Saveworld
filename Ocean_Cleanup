<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ocean Cleanup • Save The Planet</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <!-- Sticky Nav (consistent) -->
    <nav>
        <div class="nav-container">
            <div class="logo">
                <img src="assets/SavePlanetLogo.jpg" alt="Save The Planet Logo">
            </div>
            <ul class="nav-links">
                <li><a href="#solutions">Solutions</a></li>
                <li><a href="#actions">Actions</a></li>
                <li><a href="#facts">Amazing Facts</a></li>
                <li><a href="#community">Community</a></li>
            </ul>
            <a href="#join" class="btn">Join Movement</a>
        </div>
    </nav>

    <!-- Hero -->
    <section class="hero" style="background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('assets/OceanBeach.JPG') center/cover no-repeat;">
        <div class="hero-content">
            <h1>Ocean Cleanup Initiatives</h1>
            <p>Multiple industries collaborating for plastic-free oceans through innovation and action.</p>
            <a href="#industries" class="btn">Explore Industries</a>
        </div>
    </section>

    <!-- Industries -->
    <section id="industries">
        <h2>Industries Driving Ocean Cleanup</h2>
        <div class="grid">
            <div class="card">
                <h3>Technology & Engineering</h3>
                <p>The Ocean Cleanup deploys advanced barriers and AI systems.</p>
            </div>
            <div class="card">
                <h3>Corporate & Philanthropy</h3>
                <p>Companies funding global cleanup operations and research.</p>
            </div>
            <div class="card">
                <h3>Community & NGOs</h3>
                <p>Local groups removing plastics from beaches and rivers.</p>
            </div>
            <div class="card">
                <h3>Government & Policy</h3>
                <p>Regulations and international agreements supporting ocean health.</p>
            </div>
        </div>
    </section>

    <footer>
        <p>&copy; 2026 Save The Planet • Positive Action for a Thriving Earth</p>
    </footer>
</body>
</html>
